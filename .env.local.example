# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys). No domain verification needed to start —
# leave EMAIL_FROM unset to use Resend's shared onboarding@resend.dev sender.
RESEND_API_KEY=
EMAIL_FROM=

# Where new venue-interest form submissions get emailed to.
ADMIN_NOTIFICATION_EMAIL=

# /admin login. ADMIN_SESSION_SECRET can be any long random string —
# generate one with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
